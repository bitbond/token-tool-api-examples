# Copy to .env, which is git-ignored, and replace every change_me. Used by the
# Fireblocks Stellar and XRPL examples (see common/fireblocksClient.ts).
FIREBLOCKS_API_KEY=change_me
# Absolute path of the API user's private key file, kept outside the repository.
FIREBLOCKS_API_PRIVATE_KEY_PATH=change_me
# Only for a sandbox (https://sandbox-api.fireblocks.io) or EU
# (https://eu-api.fireblocks.io) workspace; leave unset otherwise.
# FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io
